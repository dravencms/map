<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <ul class="nav nav-tabs" role="tablist">
            <li n:foreach="$activeLocales as $activeLocale" role="presentation" class="nav-item"><a n:class="$activeLocale->isDefault() ? active, nav-link" href="#{$activeLocale->getLanguageCode()}" aria-controls="home"
                                                                                                                                 role="tab" data-bs-toggle="tab"><span
                            class="flag-icon flag-icon-{$activeLocale->getCountry()->getCode()|lower}"></span> {$activeLocale->getName()}</a></li>
        </ul>
        <div class="tab-content">
            <div n:foreach="$activeLocales as $activeLocale" role="tabpanel" n:class="$activeLocale->isDefault() ? active, tab-pane" id="{$activeLocale->getLanguageCode()}">
                {formContainer $activeLocale->getLanguageCode()}
                    <fieldset>
                        <legend>{$activeLocale->getName()}</legend>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="name">{_"map.admin.field.name"}</label>
                                    <input type="text" n:name="name" autofocus="autofocus" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="title">{_"map.admin.field.title"}</label>
                                    <input type="text" n:name="title" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                        </div><!-- row -->
                    </fieldset>
                {/formContainer}
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="apiKey">{_"map.admin.field.apiKey"}</label>
                    <input type="text" n:name="apiKey" class="form-control">
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-4">
                <div class="mb-3">
                    <label class="form-label" n:name="street">{_"map.admin.field.street"}</label>
                    <input type="text" n:name="street" class="form-control">
                </div>
            </div><!-- col-sm-4 -->
            <div class="col-sm-4">
                <div class="mb-3">
                    <label class="form-label" n:name="zipCode">{_"map.admin.field.zipCode"}</label>
                    <input type="text" n:name="zipCode" class="form-control">
                </div>
            </div><!-- col-sm-4 -->
            <div class="col-sm-4">
                <div class="mb-3">
                    <label class="form-label" n:name="city">{_"map.admin.field.city"}</label>
                    <input type="text" n:name="city" class="form-control">
                </div>
            </div><!-- col-sm-4 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="type">{_"map.admin.field.type"}</label>
                    <select n:name="type" class="form-control"></select>
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="zoom">{_"map.admin.field.zoom"}</label>
                    <select n:name="zoom" class="form-control"></select>
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="width">{_"map.admin.field.width"}</label>
                    <input type="number" n:name="width" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="height">{_"map.admin.field.height"}</label>
                    <input type="number" n:name="height" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="widthType">{_"map.admin.field.widthType"}</label>
                    <select n:name="widthType" class="form-control"></select>
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="heightType">{_"map.admin.field.heightType"}</label>
                    <select n:name="heightType" class="form-control"></select>
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="identifier">{_"map.admin.field.identifier"}</label>
                    <input n:name="identifier" class="form-control">
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isActive" class="form-check-input"> <span class="form-check-label">{_"map.admin.field.active"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isShowName" class="form-check-input"> <span class="form-check-label">{_"map.admin.field.showName"}</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_"map.admin.action.save"}">
    </div>
</form>